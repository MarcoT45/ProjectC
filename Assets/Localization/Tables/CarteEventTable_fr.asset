  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: CarteEventTable_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 58a07a2da95433f45940c6d5cc77769d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 42017882112
    m_Localized: "Vous rep\xE9rez un coffre cach\xE9 au milieu de la for\xEAt. Que
      peut-il contenir ?"
    m_Metadata:
      m_Items: []
  - m_Id: 616092270592
    m_Localized: "Vous tombez sur un puits magique. Peut-\xEAtre devriez-vous \xE9changer
      quelque chose ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1025624113152
    m_Localized: "Un marchand vous fait signe. Il semble qu'il ait quelque chose
      \xE0 vous vendre !"
    m_Metadata:
      m_Items: []
  - m_Id: 2027735613440
    m_Localized: "Au milieu de la for\xEAt, vous tombez sur un feu de camp. Personne
      ne semble \xEAtre \xE0 proximit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2833209753600
    m_Localized: "Vous trouvez votre SENSEI en train de m\xE9diter ! Devriez-vous
      tenter une attaque surprise ?"
    m_Metadata:
      m_Items: []
  - m_Id: 3172851908608
    m_Localized: "Vous rep\xE9rez un coffre suspect avec des traces de sang dessus.
      Faut-il l'ouvrir ?"
    m_Metadata:
      m_Items: []
  - m_Id: 365643294965760
    m_Localized: Partir
    m_Metadata:
      m_Items: []
  - m_Id: 365734563020800
    m_Localized: Se reposer
    m_Metadata:
      m_Items: []
  - m_Id: 365905086644224
    m_Localized: Commercer
    m_Metadata:
      m_Items: []
  - m_Id: 366355961741312
    m_Localized: Echanger
    m_Metadata:
      m_Items: []
  - m_Id: 366541219954688
    m_Localized: Ouvrir
    m_Metadata:
      m_Items: []
  - m_Id: 366679061561344
    m_Localized: Attaquer
    m_Metadata:
      m_Items: []
  - m_Id: 1858138042400768
    m_Localized: "Vous vous r\xE9veillez en meilleure forme. Il est temps de poursuivre
      votre voyage."
    m_Metadata:
      m_Items: []
  - m_Id: 2152000212303872
    m_Localized: "\xC0 votre r\xE9veil, vous trouvez une note \"TROP LENT\" et une
      partie de votre argent a disparu."
    m_Metadata:
      m_Items: []
  - m_Id: 2151991525900288
    m_Localized: "Ce n'\xE9tait pas de la m\xE9ditation, mais une sieste. Vous prenez
      quand m\xEAme sa bourse."
    m_Metadata:
      m_Items: []
  - m_Id: 2663634894716928
    m_Localized: "Quelle aubaine ! Le coffre renfermait de l'\xE9quipement que vous
      pouvez utiliser."
    m_Metadata:
      m_Items: []
  - m_Id: 3315097107038208
    m_Localized: "Vous n'avez malheureusement aucun objet \xE0 \xE9changer. Il ne
      vous reste qu'\xE0 repartir..."
    m_Metadata:
      m_Items: []
  - m_Id: 3315065280659456
    m_Localized: "Suite \xE0 l'\xE9change, le puits a perdu sa magie. Avez-vous r\xE9cup\xE9r\xE9
      un objet de valeur ?"
    m_Metadata:
      m_Items: []
  - m_Id: 3388065883488256
    m_Localized: 'ATK:'
    m_Metadata:
      m_Items: []
  - m_Id: 3388162688024576
    m_Localized: 'DEF:'
    m_Metadata:
      m_Items: []
  - m_Id: 3388217415303168
    m_Localized: 'VIT:'
    m_Metadata:
      m_Items: []
  - m_Id: 3388267147165696
    m_Localized: 'CHN:'
    m_Metadata:
      m_Items: []
  - m_Id: 3676737904181248
    m_Localized: "Aaaaargh ! Vous \xEAtes tomb\xE9 dans le pi\xE8ge du mimic. La
      curiosit\xE9 est un vilain d\xE9faut."
    m_Metadata:
      m_Items: []
  - m_Id: 3676735832195072
    m_Localized: "Vous trouvez de l'\xE9quipement de tr\xE8s bonne qualit\xE9. Parfois
      la curiosit\xE9 paye !"
    m_Metadata:
      m_Items: []
  - m_Id: 3965890977988608
    m_Localized: Observer
    m_Metadata:
      m_Items: []
  - m_Id: 3965972251017216
    m_Localized: Ne serait-ce pas l'un de ces fameux chasseurs de monstres ?
    m_Metadata:
      m_Items: []
  - m_Id: 3967084085510144
    m_Localized: "Vous \xEAtes fortement impressionn\xE9 par ce que vous venez de
      voir !"
    m_Metadata:
      m_Items: []
  - m_Id: 3967072962215936
    m_Localized: "Pas si fort que \xE7a apparemment. Vous prenez son \xE9quipement
      en souvenir."
    m_Metadata:
      m_Items: []
  - m_Id: 5133538059223040
    m_Localized: Marchand
    m_Metadata:
      m_Items: []
  - m_Id: 5133707337138176
    m_Localized: Coney
    m_Metadata:
      m_Items: []
  - m_Id: 5961905566253056
    m_Localized: Partir
    m_Metadata:
      m_Items: []
  - m_Id: 5961904056303616
    m_Localized: Confirmer
    m_Metadata:
      m_Items: []
  - m_Id: 5961902240169984
    m_Localized: Choisir
    m_Metadata:
      m_Items: []
  - m_Id: 6209713250631680
    m_Localized: "Apr\xE8s avoir fini de chiner. Vous saluez le marchand et reprenez
      votre route."
    m_Metadata:
      m_Items: []
  - m_Id: 6343488768966656
    m_Localized: VENDU
    m_Metadata:
      m_Items: []
  - m_Id: 6960498049679360
    m_Localized: E.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
