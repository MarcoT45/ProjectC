  m_TableData:
  - m_Id: 14563926016
    m_Localized: Casque en bronze
    m_Metadata:
      m_Items: []
  - m_Id: 378679844864
    m_Localized: "Casque en bronze peu on\xE9reux et de faible resistance."
    m_Metadata:
      m_Items: []
  - m_Id: 2970789076992
    m_Localized: Casque en argent
    m_Metadata:
      m_Items: []
  - m_Id: 3133406437376
    m_Localized: "Casque en argent de bonne facture, semble avoir d\xE9ja \xE9t\xE9
      port\xE9 par quelqu'un."
    m_Metadata:
      m_Items: []
  - m_Id: 3341049651200
    m_Localized: "Un casque en or \xE9tincelant et vraiment tr\xE8s beau."
    m_Metadata:
      m_Items: []
  - m_Id: 3399035904000
    m_Localized: "Ce casque de platine est vraiment tr\xE8s rare ! Celui qui le porte
      semble devenir un peu m\xE9galo."
    m_Metadata:
      m_Items: []
  - m_Id: 3281159184384
    m_Localized: Casque en or
    m_Metadata:
      m_Items: []
  - m_Id: 3371382857728
    m_Localized: Casque en platine
    m_Metadata:
      m_Items: []
  - m_Id: 3884795027456
    m_Localized: Torse Bronze
    m_Metadata:
      m_Items: []
  - m_Id: 3888129499136
    m_Localized: "Ce torse en bronze offre une protection suffisante pour un aventurier
      d\xE9butant."
    m_Metadata:
      m_Items: []
  - m_Id: 3892042784768
    m_Localized: Torse Argent
    m_Metadata:
      m_Items: []
  - m_Id: 4042492469248
    m_Localized: "Ce torse en argent a largement fait ses preuves par le pass\xE9,
      ne sous-estimez pas sa protection !"
    m_Metadata:
      m_Items: []
  - m_Id: 4051443113984
    m_Localized: Torse Or
    m_Metadata:
      m_Items: []
  - m_Id: 4074344013824
    m_Localized: "Ce torse en or est plus utile qu'esth\xE9tique."
    m_Metadata:
      m_Items: []
  - m_Id: 4125405470720
    m_Localized: "En portant ce torse de platine vous vous sentirez presque invincible
      \xE0 toutes les attaques que l'on vous lancera."
    m_Metadata:
      m_Items: []
  - m_Id: 4076659269632
    m_Localized: Torse Platine
    m_Metadata:
      m_Items: []
  - m_Id: 4129301979136
    m_Localized: Bottes Bronze
    m_Metadata:
      m_Items: []
  - m_Id: 4231752048640
    m_Localized: Ces bottes en bronze sentent un peu le fromage.
    m_Metadata:
      m_Items: []
  - m_Id: 4247891730432
    m_Localized: Bottes Argent
    m_Metadata:
      m_Items: []
  - m_Id: 4276278779904
    m_Localized: "Ces bottes en argent sont plus l\xE9g\xE8res qu'il n'y parait. "
    m_Metadata:
      m_Items: []
  - m_Id: 4312727281664
    m_Localized: "Ces bottes en or sont vraiment tape \xE0 l'oeil mais plutot r\xE9sistantes."
    m_Metadata:
      m_Items: []
  - m_Id: 4348374671360
    m_Localized: Avec ces bottes de platines, vous n'aurez plus jamais mal aux pieds
      mais vous ne pourrez plus marcher.
    m_Metadata:
      m_Items: []
  - m_Id: 4334248255488
    m_Localized: Bottes Platine
    m_Metadata:
      m_Items: []
  - m_Id: 4298525368320
    m_Localized: Bottes Or
    m_Metadata:
      m_Items: []
  - m_Id: 4372911349760
    m_Localized: Accessoire 1
    m_Metadata:
      m_Items: []
  - m_Id: 4387184566272
    m_Localized: Un bien bel accessoire qui brille de milles feux !
    m_Metadata:
      m_Items: []
  - m_Id: 4407254310912
    m_Localized: Accessoire 2
    m_Metadata:
      m_Items: []
  - m_Id: 4452984807424
    m_Localized: "Un accessoire \xE0 la limite du mauvais gout. Mais ou avez vous
      bien pu trouvez ca."
    m_Metadata:
      m_Items: []
  - m_Id: 4493921214464
    m_Localized: "Il s'agit d'un h\xE9ritage familial. Veuillez ne pas vous en d\xE9barassez."
    m_Metadata:
      m_Items: []
  - m_Id: 4543086845952
    m_Localized: "Parfois on ne sait pas trop quoi dire de ce que l'on poss\xE8de."
    m_Metadata:
      m_Items: []
  - m_Id: 4518868934656
    m_Localized: 'Accessoire 4 '
    m_Metadata:
      m_Items: []
  - m_Id: 4474715496448
    m_Localized: Accessoire 3
    m_Metadata:
      m_Items: []
  - m_Id: 4577224286208
    m_Localized: "Ep\xE9e Bronze"
    m_Metadata:
      m_Items: []
  - m_Id: 4597818318848
    m_Localized: "Une \xE9p\xE9e de pacotille qui devrait neanmoins vous servir pendant
      un temps."
    m_Metadata:
      m_Items: []
  - m_Id: 4636003262464
    m_Localized: "Une bonne \xE9p\xE9e qui a d\xE9ja eu raison de quelques monstres."
    m_Metadata:
      m_Items: []
  - m_Id: 4705855201280
    m_Localized: "Cette \xE9p\xE9e en or aurait un jour appartenu \xE0 un aventurier
      celebre. Peut-\xEAtre que vous rentrerez vous aussi un jour dans la l\xE9gende."
    m_Metadata:
      m_Items: []
  - m_Id: 4794266935296
    m_Localized: "Une \xE9p\xE9e digne des rois et des h\xE9ros de l'ancien temps.
      Une force inconnue semble s'\xE9chapper d'elle."
    m_Metadata:
      m_Items: []
  - m_Id: 4770049024000
    m_Localized: "Ep\xE9e Platine "
    m_Metadata:
      m_Items: []
  - m_Id: 4659692691456
    m_Localized: "Ep\xE9e Or"
    m_Metadata:
      m_Items: []
  - m_Id: 4620178153472
    m_Localized: "Ep\xE9e Argent"
    m_Metadata:
      m_Items: []
