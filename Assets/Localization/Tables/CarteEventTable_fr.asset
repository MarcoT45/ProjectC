  m_TableData:
  - m_Id: 42017882112
    m_Localized: "Vous rep\xE9rez un coffre cach\xE9 au milieu de la for\xEAt. Que
      peut-il contenir ?"
    m_Metadata:
      m_Items: []
  - m_Id: 616092270592
    m_Localized: "Vous tombez sur un puits magique. Peut-\xEAtre devriez-vous \xE9changer
      quelque chose ?"
    m_Metadata:
      m_Items: []
  - m_Id: 1025624113152
    m_Localized: "Un marchand vous fait signe. Il semble qu'il ait quelque chose
      \xE0 vous vendre !"
    m_Metadata:
      m_Items: []
  - m_Id: 2027735613440
    m_Localized: "Au milieu de la for\xEAt, vous tombez sur un feu de camp. Personne
      ne semble \xEAtre \xE0 proximit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2833209753600
    m_Localized: "Cette grenouille a une t\xEAte qui ne vous revient pas. Devriez-vous
      lui p\xE9ter la gueule ?"
    m_Metadata:
      m_Items: []
  - m_Id: 3172851908608
    m_Localized: "Mais c'est le l\xE9gendaire Pepe ! Il semble si heureux dans la
      for\xEAt ! "
    m_Metadata:
      m_Items: []
